# Stable, non-secret CI delivery config for the frontend pipeline (P17).
# Loaded by the Jenkinsfile (readFile + parse) which FAILS if a required key is missing.
# These are publish targets + pinned tool refs, NOT per-run toggles — change them via a
# reviewed commit, never as a casual build parameter. NO SECRETS HERE: secret material
# (deploy keys, webhook HMAC) lives only in Jenkins / AWS Secrets Manager credentials,
# referenced below by credential ID (an identifier, not a secret).
#
# Format: KEY=value, one per line. '#' comments and blank lines ignored. No quoting.

# --- AWS / ECR (account 832285994273, ap-south-1) ---
AWS_DEFAULT_REGION=ap-south-1
ECR_REGISTRY=832285994273.dkr.ecr.ap-south-1.amazonaws.com
ECR_REPO=modelmatch-frontend

# --- E2E throwaway stack: the already-published backend image it runs against ---
E2E_BACKEND_REPO=modelmatch-backend
E2E_BACKEND_TAG=1.0.1

# --- pinned tool images (digest-pinned for reproducibility) ---
# node 22.20.0-bookworm
NODE_IMAGE=node:22.20.0-bookworm@sha256:915acd9e9b885ead0c620e27e37c81b74c226e0e1c8177f37a60217b6eabb0d7
# Playwright image MUST match the @playwright/test version in package.json (1.60.0).
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.60.0-noble
# trivy 0.71.1
TRIVY_IMAGE=aquasec/trivy:0.71.1@sha256:53570e6911c2361ebe7995228088cf83a6b9b73e7f3cdca44bd8f8f425e80fa7
# yq 4.47.1
YQ_IMAGE=mikefarah/yq:4.47.1@sha256:b9285dd3b0bea3c34d0c54415dd48d767dabd9644d489bd6e253660847b58419

# --- release-tail git targets ---
FE_REPO_SSH=git@github.com:Steve-droid/driftplain-frontend.git
GITOPS_REPO=git@github.com:Steve-droid/driftplain-gitops.git
GITOPS_VALUES=charts/modelmatch/values.yaml

# --- credential IDs (== Secrets Manager secret names; identifiers, not secrets) ---
CRED_FE_DEPLOY_KEY=modelmatch-jenkins-frontend-deploy-key
CRED_GITOPS_KEY=modelmatch-jenkins-gitops-deploy-key
